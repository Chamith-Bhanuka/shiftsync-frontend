# Normal REST traffic goes through the API Gateway
VITE_API_BASE_URL=http://localhost:8080/api

# WebSocket connects DIRECTLY to notification-service, bypassing the Gateway.
# Spring Cloud Gateway MVC (used in this project) cannot proxy WebSocket
# connections — this is a real limitation of that specific Gateway flavor,
# not a workaround for a bug. See README-UI-Enhancement-Spec.md for details.
VITE_NOTIFICATION_WS_URL=http://localhost:8082
